{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "workflow": {
        "id": "simple_message_broadcast_001",
        "name": "Simple Message Broadcast",
        "description": "A workflow to send a broadcast message to an audience with campaign details.",
        "steps": [
            {
                "step": "Extract Information",
                "type": "llm_call",
                "parameters": {
                    "system_prompt": "Extract the audience and campaign message from the given user prompt.",
                    "prompt": "$initial_context.prompt",
                    "input_keys": [],
                    "output_keys": [
                        "audience",
                        "campaign_message"
                    ],
                    "yield": {
                        "message": "Extracted audience as '$context.audience' and campaign message as '$context.campaign_message'.",
                        "type": "text"
                    }
                }
            },
            {
                "step": "Yield Leads Title",
                "type": "yield_message",
                "parameters": {
                    "yield": {
                        "message": "We have extracted the following leads for your audience",
                        "type": "text"
                    }
                }
            },
            {
                "step": "Get Leads",
                "type": "tool_call",
                "parameters": {
                    "tool": "fetch_leads",
                    "input_keys": [
                        "audience"
                    ],
                    "output_keys": [
                        "leads"
                    ],
                    "yield": {
                        "message": "$context.leads",
                        "type": "table"
                    }
                }
            },
            {
                "step": "Write a Campaign Email",
                "type": "llm_call",
                "parameters": {
                    "system_prompt": "As an expert marketing and technical writer, please re-write a professional campaign email for the given audience and campaign_message (given in the user prompt). Please use html tags like <p>, <ul>, <li>, <h2> etc to format the email message. Please write an appealing subject line for the email. In Salutation, just write 'Dear Sir/Madam'.",
                    "prompt": "audience: $context.audience, campaign_message: $context.campaign_message",
                    "input_keys": [
                        "audience",
                        "campaign_message"
                    ],
                    "output_keys": [
                        "email_contents",
                        "subject"
                    ],
                    "yield": {
                        "message": "Email subject: $context.subject, Email contents: $context.email_contents",
                        "type": "text"
                    }
                }
            },
            {
                "step": "Send Campaign Email",
                "type": "tool_call",
                "parameters": {
                    "tool": "broadcast_email",
                    "input_keys": [
                        "leads",
                        "subject",
                        "email_contents"
                    ],
                    "output_keys": [],
                    "yield": {
                        "message": "Email sent to the audience.",
                        "type": "text"
                    }
                }
            }
        ]
    }
}